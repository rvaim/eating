{
  "name": "Eating",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "host": "node --import tsx apps/host/src/main.ts",
    "start": "node apps/host/dist/main.mjs",
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs host",
    "build:plugin": "node scripts/build.mjs plugin plugins/communication/qq",
    "plugin": "node --import tsx apps/host/src/plugin-cli.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@eating/plugin-sdk": "workspace:^",
    "@eating/ui-sdk": "workspace:^",
    "@eating/plugin-core": "workspace:^",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
